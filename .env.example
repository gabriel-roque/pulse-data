COMPOSE_PROJECT_NAME=pulse
PULSE_IMAGE=pulse:local

POSTGRES_USER=pulse
POSTGRES_PASSWORD=change-me-local
POSTGRES_DB=pulse
PULSE_POSTGRES_DSN=postgres://pulse:change-me-local@postgres:5432/pulse?sslmode=disable
PULSE_REDIS_URL=redis://redis:6379/0
PULSE_KAFKA_BROKERS=kafka:9092
PULSE_KAFKA_TOPIC=events.raw
PULSE_CLICKHOUSE_ADDR=clickhouse:9000
PULSE_CLICKHOUSE_DATABASE=default
PULSE_ADMIN_TOKEN=change-me-admin
PULSE_RATE_LIMIT=1000
PULSE_RATE_WINDOW=1m
PULSE_MAX_PAYLOAD_BYTES=1048576
PULSE_ALLOW_PRIVATE_WEBHOOKS=false
PULSE_METRICS_ADDR=:9091
PULSE_UI_PORT=3001
TEMPO_OTLP_GRPC_PORT=4317
TEMPO_OTLP_HTTP_PORT=4318

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-grafana
